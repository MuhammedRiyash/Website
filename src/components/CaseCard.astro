---
import DevicePair from './DevicePair.astro';
import Icon from './Icon.astro';
import type { CaseStudy } from '../data/work';
import { href } from '../lib/url';

interface Props {
  item: CaseStudy;
  index: number;
  headingLevel?: 'h2' | 'h3';
}
const { item, index, headingLevel: H = 'h3' } = Astro.props;
const link = href(`work/${item.slug}`);
---

<li
  class="case"
  data-filter-item
  data-tech={item.filters.join('|')}
  style={`--step:${Math.min(index, 4)};view-timeline-name:--case-${index};--next-card:--case-${index + 1}`}
>
  <article class="case__card">
    <div class="case__body">
      <div class="case__meta">
        <span class="mono case__index">— {String(index + 1).padStart(2, '0')}</span>
        <span class="chip chip--tint">{item.label}</span>
        <span class="chip">{item.period}</span>
      </div>
      <H class="case__title">
        <a href={link}>
          <span>{item.client},</span> <span class="case__desc">{item.descriptor}</span>
        </a>
      </H>
      <p class="case__summary">{item.summary}</p>
      <dl class="case__metrics">
        {
          item.metrics.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="case__stack" aria-label="Stack">
        {item.stack.slice(0, 6).map((s) => <li class="chip">{s}</li>)}
      </ul>
      <span class="arrow-link case__more" aria-hidden="true">
        Read the case study <Icon name="arrow-up-right" />
      </span>
    </div>
    <div class="case__visual">
      <DevicePair visual={item.visuals[0]} />
    </div>
  </article>
</li>

<style>
  .case__card {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 -16px 40px -32px rgb(14 16 20 / 0.35);
    transition: border-color 0.3s ease;
  }
  .case__card:hover {
    border-color: var(--color-line-strong);
  }
  .case__card:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .case__body {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    min-width: 0;
  }
  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .case__index {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-right: 0.25rem;
  }
  .case__title {
    font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.25rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }
  .case__title a {
    text-decoration: none;
    color: inherit;
  }
  .case__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .case__title a:focus-visible {
    outline: none;
  }
  .case__desc {
    color: var(--color-muted);
  }
  .case__summary {
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 1rem;
    margin: 0.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .case__metrics div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }
  .case__metrics dd {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--color-accent-hover);
  }
  .case__metrics dt {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .case__more {
    margin-top: 0.25rem;
  }
  .case__card:hover .case__more {
    color: var(--color-accent-hover);
  }
  .case__card:hover .case__more :global(svg) {
    transform: translate(3px, -3px);
  }
  .case__visual {
    min-width: 0;
    align-self: center;
  }
  /* Desktop: compact two-column card (≤ ~540 px tall) so stacked cards fit laptop screens. */
  @media (min-width: 1024px) {
    .case__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 3vw, 3rem);
      align-items: center;
      padding: 28px 32px;
    }
    .case__body {
      gap: 0.875rem;
    }
    .case__title {
      font-size: clamp(1.375rem, 0.95rem + 0.85vw, 1.75rem);
      line-height: 1.15;
      text-wrap: balance;
    }
    .case__summary {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
      font-size: 0.9375rem;
    }
    .case__metrics {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 1.25rem;
      margin: 0;
      padding-top: 0.875rem;
    }
    .case__metrics dd {
      font-size: 1.5rem;
    }
    .case__metrics dt {
      font-size: 0.8125rem;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    .case__stack :global(li:nth-child(n + 5)) {
      display: none;
    }
    .case__more {
      margin-top: 0;
      min-height: 32px;
    }
    /* Keep the device pair to ~330 px tall so the whole card fits under the sticky offset. */
    .case__visual :global(.dp) {
      max-width: 460px;
      margin-inline: auto;
    }
  }

  /* Depth on scroll: as the next card slides over this one, this card recedes (scale) and its content
     dims. Driven by the NEXT card's view timeline (names are set inline on each <li>; the list declares
     them with timeline-scope). Pure CSS; unsupported browsers and reduced motion just stack plainly. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) and (min-height: 640px) {
      .case__card {
        transform-origin: 50% 0;
        animation: case-recede linear both;
        animation-timeline: var(--next-card);
        animation-range: entry 20% entry 100%;
      }
      .case__card > * {
        animation: case-dim linear both;
        animation-timeline: var(--next-card);
        animation-range: entry 20% entry 100%;
      }
    }
  }
  @keyframes case-recede {
    to {
      transform: scale(0.94);
    }
  }
  @keyframes case-dim {
    to {
      opacity: 0.55;
    }
  }
</style>
