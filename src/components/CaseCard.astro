---
import DevicePair from './DevicePair.astro';
import Icon from './Icon.astro';
import type { CaseStudy } from '../data/work';
import { href } from '../lib/url';

interface Props {
  item: CaseStudy;
  index: number;
  headingLevel?: 'h2' | 'h3';
}
const { item, index, headingLevel: H = 'h3' } = Astro.props;
const link = href(`work/${item.slug}`);
---

<li class="case" data-filter-item data-tech={item.filters.join('|')}>
  <article class="case__card">
    <div class="case__body">
      <div class="case__meta">
        <span class="mono case__index">— {String(index + 1).padStart(2, '0')}</span>
        <span class="chip chip--tint">{item.label}</span>
        <span class="chip">{item.period}</span>
      </div>
      <H class="case__title">
        <a href={link}>
          <span>{item.client},</span> <span class="case__desc">{item.descriptor}</span>
        </a>
      </H>
      <p class="case__summary">{item.summary}</p>
      <dl class="case__metrics">
        {
          item.metrics.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="case__stack" aria-label="Stack">
        {item.stack.slice(0, 6).map((s) => <li class="chip">{s}</li>)}
      </ul>
      <span class="arrow-link case__more" aria-hidden="true">
        Read the case study <Icon name="arrow-up-right" />
      </span>
    </div>
    <div class="case__visual">
      <DevicePair visual={item.visuals[0]} />
    </div>
  </article>
</li>

<style>
  .case__card {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 -16px 40px -32px rgb(14 16 20 / 0.35);
    transition: border-color 0.3s ease;
  }
  .case__card:hover {
    border-color: var(--color-line-strong);
  }
  .case__card:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .case__body {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    min-width: 0;
  }
  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .case__index {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-right: 0.25rem;
  }
  .case__title {
    font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.25rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }
  .case__title a {
    text-decoration: none;
    color: inherit;
  }
  .case__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .case__title a:focus-visible {
    outline: none;
  }
  .case__desc {
    color: var(--color-muted);
  }
  .case__summary {
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
    gap: 1rem;
    margin: 0.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .case__metrics div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }
  .case__metrics dd {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--color-accent-hover);
  }
  .case__metrics dt {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .case__more {
    margin-top: 0.25rem;
  }
  .case__card:hover .case__more {
    color: var(--color-accent-hover);
  }
  .case__card:hover .case__more :global(svg) {
    transform: translate(3px, -3px);
  }
  .case__visual {
    min-width: 0;
    align-self: center;
  }
  @media (min-width: 1024px) {
    .case__card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 3rem;
      align-items: center;
    }
  }
</style>
