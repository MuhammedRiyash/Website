---
/**
 * Case studies as sticky stacked cards. With `filter` (default) it renders its own tech filter;
 * pass `filter={false}` when a parent `data-filter-root` already provides one.
 */
import CaseCard from './CaseCard.astro';
import TechFilter from './TechFilter.astro';
import type { CaseStudy } from '../data/work';

interface Props {
  items: CaseStudy[];
  headingLevel?: 'h2' | 'h3';
  filter?: boolean;
}
const { items, headingLevel = 'h3', filter = true } = Astro.props;
// Each card exposes a view timeline (--case-N); the list hoists them so card N-1 can animate on card N's.
const scope = `timeline-scope:${items.map((_, i) => `--case-${i}`).join(',')}`;
---

{
  filter ? (
    <div data-filter-root>
      <TechFilter total={items.length} noun="case studies" available={items.flatMap((i) => i.filters)} />
      <ol class="cases" role="list" style={scope}>
        {items.map((item, i) => <CaseCard item={item} index={i} headingLevel={headingLevel} />)}
      </ol>
    </div>
  ) : (
    <ol class="cases" role="list" style={scope}>
      {items.map((item, i) => <CaseCard item={item} index={i} headingLevel={headingLevel} />)}
    </ol>
  )
}

<style>
  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  /* Stack on laptop screens too: compact cards (~540 px) fit under the header at ≥ 640 px tall. */
  @media (min-width: 1024px) and (min-height: 640px) {
    .cases {
      gap: 32px;
      /* Room after the last card so it settles into its stuck position. */
      padding-bottom: 12vh;
    }
    .cases :global(> li) {
      position: sticky;
      top: calc(80px + 16px + var(--step, 0) * 10px);
    }
  }
</style>
