---
/** Final conversion block: "what happens next", direct channels and the enquiry form. */
import ContactForm from './ContactForm.astro';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';
import { person } from '../data/site';

interface Props {
  source: string;
  title?: string;
  intro?: string;
  preselect?: string;
  formId?: string;
}
const {
  source,
  title = 'Tell me what you’re building.',
  intro = 'Where you are today, what needs to change, and when. You’ll hear back from me — the person who would write the code.',
  preselect,
  formId,
} = Astro.props;

const steps = [
  { title: 'Share the context', body: 'Send the form or a message. A few lines is plenty.' },
  { title: 'Talk it through', body: 'A short call or email thread to understand the goal and constraints.' },
  { title: 'Get a written scope', body: 'Features, stack, risks, timeline and a quote — in writing, before any work starts.' },
];
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="cs" data-reveal>
      <div class="cs__intro">
        <Eyebrow label="Start a project" aside="I reply within one working day" />
        <h2 id="contact-title" class="t-h2">{title}</h2>
        <p class="t-lead">{intro}</p>
        <ol class="cs__steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="cs__num mono">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <ul class="cs__direct">
          <li>
            <a href={`mailto:${person.email}`}><Icon name="mail" />{person.email}</a>
          </li>
          <li>
            <a href={person.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />WhatsApp {person.phone}</a>
          </li>
        </ul>
      </div>
      <div class="cs__form">
        <ContactForm source={source} preselect={preselect} id={formId} />
      </div>
    </div>
  </div>
</section>

<style>
  .cs {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(24px, 4vw, 56px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  @media (min-width: 1024px) {
    .cs {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }
  .cs__intro {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }
  .cs__steps {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }
  .cs__steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .cs__num {
    font-size: 0.8125rem;
    color: var(--color-accent-hover);
    padding-top: 0.2rem;
  }
  .cs__steps h3 {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }
  .cs__steps p {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .cs__direct {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }
  .cs__direct a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cs__direct a:hover {
    color: var(--color-accent-hover);
  }
  .cs__direct :global(svg) {
    flex: none;
    color: var(--color-accent);
  }
</style>
