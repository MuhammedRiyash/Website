---
import Icon from './Icon.astro';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, person, socials } from '../data/site';
import { href, isActive } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a href={href()} class="site-header__brand" aria-label={`${person.shortName} — Full-Stack Web Development, home`}>
      <Wordmark />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={href(item.path)} aria-current={isActive(current, item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle class="site-header__theme" />
      <Button href={href('contact')} class="site-header__cta">Start a project</Button>
      <button
        type="button"
        class="menu-toggle"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-haspopup="dialog"
        data-menu-open
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label="Site menu" data-menu>
  <div class="menu__inner">
    <div class="menu__top wrap">
      <a href={href()} class="site-header__brand" aria-label={`${person.shortName} — home`}>
        <Wordmark />
      </a>
      <button type="button" class="menu-toggle menu-toggle--close" data-menu-close>
        <span class="sr-only">Close menu</span>
        <Icon name="close" size={22} />
      </button>
    </div>
    <nav class="menu__nav wrap" aria-label="Mobile">
      <ol>
        <li>
          <a href={href()} aria-current={current.replace(/\/+$/, '') === href().replace(/\/+$/, '') ? 'page' : undefined}>
            <span class="menu__num">00</span>Home
          </a>
        </li>
        {
          nav.map((item, i) => (
            <li>
              <a href={href(item.path)} aria-current={isActive(current, item.path) ? 'page' : undefined}>
                <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__foot wrap">
      <Button href={href('contact')} size="lg">Start a project</Button>
      <ThemeToggle withLabel />
      <div class="menu__contact">
        <a href={`mailto:${person.email}`} class="link">{person.email}</a>
        <a href={person.phoneHref} class="link">{person.phone}</a>
      </div>
      <ul class="menu__social" aria-label="Profiles">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      height 0.3s var(--ease-out-soft),
      background-color 0.3s ease,
      border-color 0.3s ease,
      backdrop-filter 0.3s ease;
  }
  :global(.header-spacer) {
    height: 80px;
  }
  :global(html.is-scrolled) {
    --header-h: 64px;
  }
  :global(html.is-scrolled) .site-header {
    background: var(--color-header-bg);
    border-bottom-color: var(--color-line);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
    border-radius: 6px;
  }
  .site-nav {
    display: none;
  }
  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.875rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0.875rem;
    right: 0.875rem;
    bottom: 8px;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-soft);
  }
  .site-nav a:hover {
    color: var(--color-ink);
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-header__actions :global(.site-header__cta),
  .site-header__actions :global(.site-header__theme) {
    display: none;
  }
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .menu-toggle:hover {
    border-color: var(--color-line-strong);
  }
  @media (min-width: 768px) {
    .site-header__actions :global(.site-header__cta),
    .site-header__actions :global(.site-header__theme) {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }
    .site-header__actions .menu-toggle {
      display: none;
    }
  }

  /* Mobile menu (native modal dialog: inert background + Esc built in, plus a Tab trap) */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu::backdrop {
    background: var(--color-backdrop);
  }
  .menu[open] {
    animation: menu-in 0.35s var(--ease-out-soft);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 2rem;
  }
  .menu__top {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-line);
  }
  .menu__nav ol {
    list-style: none;
    margin: 0;
    padding: 1rem 0;
  }
  .menu__nav li + li {
    border-top: 1px solid var(--color-line);
  }
  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 540;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-decoration: none;
    color: var(--color-ink);
  }
  .menu__nav a[aria-current='page'] {
    color: var(--color-accent-hover);
  }
  .menu__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    transform: translateY(-0.9em);
  }
  .menu__foot {
    margin-top: auto;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-top: 1.5rem;
  }
  .menu__contact {
    display: grid;
    gap: 0.25rem;
  }
  .menu__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .menu__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .menu__social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>

<noscript>
  <style>
    .site-nav {
      display: block !important;
    }
    .site-nav ul {
      flex-wrap: wrap;
    }
    .site-nav a {
      padding: 0 0.5rem;
    }
    .menu-toggle {
      display: none !important;
    }
    .site-header__cta {
      display: none !important;
    }
  </style>
</noscript>

<script>
  const root = document.documentElement;
  const onScroll = () => root.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openBtn && closeBtn) {
    const focusables = () =>
      Array.from(
        dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.offsetParent !== null);

    const open = () => {
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
      root.classList.add('menu-open');
      closeBtn.focus();
    };
    const close = () => {
      if (dialog.open) dialog.close();
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    dialog.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      root.classList.remove('menu-open');
      openBtn.focus();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a[href]')) close();
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
