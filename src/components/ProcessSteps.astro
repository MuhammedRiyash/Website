---
/** Discover → Plan → Build → Launch & measure. Optional per-step detail lines (service pages). */
import { processSteps } from '../data/home';

interface Props {
  details?: readonly string[];
}
const { details } = Astro.props;
---

<ol class="ps" role="list">
  {
    processSteps.map((step, i) => (
      <li class="ps__step" data-reveal style={`--d:${i}`}>
        <span class="ps__num mono">{`{ ${String(i + 1).padStart(2, '0')} }`}</span>
        <h3 class="ps__name">{step.name}</h3>
        <p class="ps__body">{details?.[i] ?? step.body}</p>
        {!details && (
          <ul class="ps__tags" aria-label={`${step.name} outputs`}>
            {step.tags.map((t) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  .ps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    counter-reset: step;
  }
  @media (min-width: 768px) {
    .ps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .ps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .ps__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: clamp(24px, 2.4vw, 32px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .ps__step::after {
    content: '';
    position: absolute;
    top: 0;
    left: clamp(24px, 2.4vw, 32px);
    width: 40px;
    height: 2px;
    background: var(--color-accent);
  }
  .ps__num {
    font-size: 0.8125rem;
    color: var(--color-accent-hover);
  }
  .ps__name {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }
  .ps__body {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
  }
  .ps__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    padding-top: 0.5rem;
  }
</style>
