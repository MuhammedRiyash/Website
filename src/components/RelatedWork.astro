---
import DevicePair from './DevicePair.astro';
import Icon from './Icon.astro';
import type { CaseStudy } from '../data/work';
import { href } from '../lib/url';

interface Props {
  items: CaseStudy[];
}
const { items } = Astro.props;
---

<ul class="rw" role="list">
  {
    items.map((c, i) => (
      <li data-reveal style={`--d:${i}`}>
        <a href={href(`work/${c.slug}`)} class="rw__card">
          <DevicePair visual={c.visuals[0]} sizes="(min-width: 1024px) 380px, 100vw" />
          <span class="rw__meta">
            <span class="chip chip--tint">{c.label}</span>
            <span class="rw__arrow">
              <Icon name="arrow-up-right" />
            </span>
          </span>
          <h3 class="rw__title">
            {c.client}, <span class="muted">{c.descriptor}</span>
          </h3>
          {c.metrics[0] && (
            <span class="rw__metric">
              <strong>{c.metrics[0].value}</strong> {c.metrics[0].label}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .rw {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .rw {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    }
  }
  .rw li {
    display: flex;
  }
  .rw__card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(20px, 2.4vw, 28px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s var(--ease-out-soft);
  }
  .rw__card:hover {
    border-color: var(--color-line-strong);
  }
  .rw__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rw__arrow :global(svg) {
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rw__card:hover .rw__arrow :global(svg) {
    transform: translate(3px, -3px);
  }
  .rw__title {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .rw__metric {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .rw__metric strong {
    color: var(--color-accent-hover);
    font-weight: 600;
  }
</style>
