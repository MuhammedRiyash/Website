---
/** "Stack evolution": a stepped timeline of the technologies added build by build. */
import Eyebrow from './Eyebrow.astro';

const steps = [
  { year: '2023', tech: 'React + Laravel', note: 'Task app, REST APIs' },
  { year: '2023 – 25', tech: 'WordPress · WooCommerce · Shopify', note: '12+ sites, custom plugins, CRO' },
  { year: '2026', tech: 'Astro · Preact · headless', note: 'Server-rendered storefronts' },
  { year: '2026', tech: 'Laravel 13 platforms', note: 'Multi-store commerce, GST' },
  { year: '2026', tech: 'Next.js 16 · Prisma · encryption', note: 'Booking and inventory products' },
  { year: '2026', tech: 'Medusa v2', note: 'Headless commerce back end' },
  { year: '2026', tech: 'AI agents · Claude / GPT APIs', note: 'Content tooling' },
];
---

<section class="section band" aria-labelledby="evo-title">
  <div class="wrap">
    <div class="evo__head" data-reveal>
      <Eyebrow label="Stack evolution" aside="2023 – 2026" />
      <h2 id="evo-title" class="t-h2">The stack has grown with every build</h2>
    </div>
    <ol class="evo" role="list">
      {
        steps.map((s, i) => (
          <li class="evo__step" style={`--i:${i}`} data-reveal>
            <span class="evo__bar" aria-hidden="true" />
            <span class="evo__year mono">{s.year}</span>
            <span class="evo__tech">{s.tech}</span>
            <span class="evo__note">{s.note}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .evo__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .evo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .evo {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .evo {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
  .evo__step {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    min-width: 0;
  }
  /* Each step is a little taller than the last: the stepped "staircase". */
  /* Every bar sits on the same baseline inside a fixed 76 px slot and rises a step per build. */
  .evo__bar {
    display: block;
    height: 76px;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-line-strong);
    background: linear-gradient(
        color-mix(in srgb, var(--color-accent) calc(30% + var(--i) * 10%), transparent),
        color-mix(in srgb, var(--color-accent) calc(30% + var(--i) * 10%), transparent)
      )
      bottom / 100% calc(12px + var(--i) * 10px) no-repeat;
    border-radius: 0;
  }
  .evo__year {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-hover);
  }
  .evo__tech {
    font-weight: 560;
    letter-spacing: -0.015em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .evo__note {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
