---
/** Brand lockup: emerald tick + "MD Riyash" wordmark + mono "Full-Stack Web Development" descriptor. */
interface Props {
  tone?: 'ink' | 'paper';
}
const { tone = 'ink' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${tone}`]}>
  <span class="wordmark__tick" aria-hidden="true"></span>
  <span class="wordmark__text">
    <span class="wordmark__name">MD Riyash</span>
    <span class="wordmark__desc">Full-Stack Web Development</span>
  </span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1;
  }
  .wordmark__tick {
    width: 12px;
    height: 28px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--color-accent) 0 58%, transparent 58% 70%, var(--color-accent) 70%);
    flex: none;
  }
  .wordmark__text {
    display: grid;
    gap: 0.3rem;
  }
  .wordmark__name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .wordmark__desc {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .wordmark--paper .wordmark__name {
    color: var(--color-on-night);
  }
  .wordmark--paper .wordmark__desc {
    color: var(--color-night-muted);
  }
</style>
