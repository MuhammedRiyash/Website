---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { nav } from '../data/site';
import { href } from '../lib/url';
---

<Base title="Page not found" description="This page doesn’t exist. Try the services, work, about or contact pages." path="404" noindex leadPopup={false}>
  <section class="nf">
    <div class="wrap nf__inner">
      <Eyebrow label="Error 404" aside="page not found" />
      <h1 class="t-display">This page didn’t ship.</h1>
      <p class="t-lead">
        The link may be old or mistyped. The site was rebuilt recently, so some addresses changed — everything is still reachable from
        here.
      </p>
      <div class="nf__actions">
        <Button href={href()} size="lg" icon="arrow-left">Back to home</Button>
        <Button href={href('contact')} variant="secondary" size="lg">Contact me</Button>
      </div>
      <nav aria-label="Main pages" class="nf__nav">
        <ul role="list">
          {
            nav.map((n) => (
              <li>
                <a class="link" href={href(n.path)}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(64px, 12vw, 160px);
  }
  .nf__inner {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .nf h1 {
    max-width: 14ch;
  }
  .nf .t-lead {
    max-width: 52ch;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .nf__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nf__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
