---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { person, socials } from '../data/site';
import { faqs } from '../data/home';

const crumbs = [{ name: 'Contact', path: 'contact' }];
const channels: { icon: IconName; label: string; value: string; href: string; external?: boolean }[] = [
  { icon: 'mail', label: 'Email', value: person.email, href: `mailto:${person.email}` },
  { icon: 'phone', label: 'Phone', value: person.phone, href: person.phoneHref },
  { icon: 'whatsapp', label: 'WhatsApp', value: 'Message me on WhatsApp', href: person.whatsapp, external: true },
];
const socialIcon: Record<string, IconName> = { LinkedIn: 'linkedin', GitHub: 'github', X: 'x', WhatsApp: 'whatsapp' };
const contactFaqs = faqs.filter((f) => /available|scope|long/i.test(f.q));
---

<Base
  title="Contact — Start a Full-Stack Web Development Project"
  description="Tell me about your website, store or back end. Email, phone, WhatsApp or the project form — I reply within one working day."
  path="contact"
  breadcrumbs={crumbs}
  footerCta={false}
  leadPopup={false}
>
  <PageHero
    label="Contact"
    aside="I reply within one working day"
    title="Let’s talk about"
    titleMuted="what you’re building."
    lead="Send a few lines about the site, the problem and your timeline. You’ll hear back from me directly — no sales team, no autoresponder sequence."
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="form-title">
    <div class="wrap contact">
      <div class="contact__form" data-reveal>
        <h2 id="form-title" class="t-h3">Project enquiry</h2>
        <ContactForm source="contact" id="contact-page-form" />
      </div>

      <aside class="contact__side" aria-label="Other ways to reach me">
        <div class="card side-card" data-reveal>
          <Eyebrow label="Direct" aside="whatever’s fastest" />
          <ul class="channels" role="list">
            {
              channels.map((c) => (
                <li>
                  <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    <span class="channels__icon">
                      <Icon name={c.icon} size={20} />
                    </span>
                    <span>
                      <span class="channels__label mono">{c.label}</span>
                      <span class="channels__value">{c.value}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="side-note">Based in {person.location} · working remotely with clients anywhere.</p>
        </div>

        <div class="card side-card" data-reveal>
          <Eyebrow label="Profiles" />
          <ul class="profiles" role="list">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer">
                    <Icon name={socialIcon[s.label]} size={18} />
                    <span>{s.label}</span>
                    <span class="profiles__handle mono">{s.handle}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card side-card side-card--dark on-night" data-reveal>
          <Eyebrow label="What happens next" />
          <ol class="next" role="list">
            <li><span class="mono">01</span> I read your message and reply within one working day.</li>
            <li><span class="mono">02</span> We talk it through by call or email.</li>
            <li><span class="mono">03</span> You get a written scope with timeline and quote.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <section class="section band" aria-labelledby="cfaq-title">
    <div class="wrap cfaq">
      <div data-reveal>
        <Eyebrow label="Before you write" />
        <h2 id="cfaq-title" class="t-h2 mt-5">Quick answers</h2>
      </div>
      <div data-reveal>
        <Faq items={contactFaqs} />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }
  .contact__form {
    display: grid;
    gap: 1.5rem;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .contact__side {
    display: grid;
    gap: 1rem;
  }
  .side-card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(20px, 3vw, 32px);
  }
  .side-card--dark {
    background: var(--color-night);
    border-color: var(--color-night);
    color: var(--color-night-muted);
  }
  .channels,
  .profiles,
  .next {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .channels a {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 0.5rem 0;
    text-decoration: none;
    color: var(--color-ink);
  }
  .channels__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 10px;
    background: var(--color-accent-tint);
    color: var(--color-accent-hover);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .channels a:hover .channels__icon {
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
  }
  .channels__label {
    display: block;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .channels__value {
    display: block;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .side-note {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .profiles a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .profiles a:hover {
    color: var(--color-accent-hover);
  }
  .profiles__handle {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
    text-align: right;
  }
  .next {
    gap: 0.875rem;
    color: var(--color-on-night);
  }
  .next li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
  }
  .next .mono {
    color: #3fd0a6;
    font-size: 0.8125rem;
    padding-top: 0.2rem;
  }
  .cfaq {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .cfaq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
  }
</style>
