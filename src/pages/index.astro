---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHead from '../components/SectionHead.astro';
import HeroLog from '../components/HeroLog.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CaseStack from '../components/CaseStack.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.jpg';
import { clients, stack } from '../data/site';
import { standards, faqs } from '../data/home';
import { caseStudies } from '../data/work';
import { href } from '../lib/url';

const featured = caseStudies.filter((c) => c.featured);
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base path="" schema={[faqSchema]}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <Eyebrow label="Full-stack web development" aside="Bengaluru · remote" />
        <h1 id="hero-title" class="t-display">
          Websites and online stores that load fast, convert, and <span class="hero__em">keep working after launch.</span>
        </h1>
        <p class="t-lead hero__lead">
          I’m Muhammed Riyash, a full-stack developer who builds and fixes storefronts, plugins and back ends for growing
          businesses. You work directly with me — the person writing the code.
        </p>
        <div class="hero__actions">
          <Button href={href('contact')} size="lg">Start a project</Button>
          <Button href="#work" variant="secondary" size="lg" icon="arrow-right">See the work</Button>
        </div>
        <div class="hero__proof">
          <Image src={portrait} alt="Portrait of Muhammed Riyash" width={96} height={96} class="hero__avatar" loading="eager" />
          <p>
            <strong>3+ years · 20+ production sites</strong>
            <span>Astro, React, Laravel, WordPress and Shopify</span>
          </p>
        </div>
      </div>
      <div class="hero__visual">
        <HeroLog />
      </div>
    </div>
  </section>

  <!-- Selected clients -->
  <section class="clients" aria-labelledby="clients-title">
    <div class="wrap clients__inner">
      <h2 id="clients-title" class="eyebrow clients__label">Selected clients <span class="aside">/ since 2023</span></h2>
      <ul class="clients__list" role="list">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead
        id="services-title"
        label="Services"
        aside="what I build"
        title="What I build for businesses that sell online"
        intro="Each service is a focused engagement with a written scope. Most projects combine two or three — a storefront with its plugins, or a speed pass with technical SEO."
      >
        <a href={href('services')} class="arrow-link">All services <Icon name="arrow-up-right" /></a>
      </SectionHead>
      <ServiceGrid />
    </div>
  </section>

  <!-- Featured work -->
  <section class="section band" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead
        id="work-title"
        label="Selected work"
        aside="real numbers only"
        title="Work that shipped, with the numbers to show for it"
        intro="Commerce builds across the stack — headless storefronts, Laravel platforms, secure booking flows, WooCommerce plugins and Shopify CRO. Every figure here comes from shipped work."
      >
        <a href={href('work')} class="arrow-link">All work <Icon name="arrow-up-right" /></a>
      </SectionHead>
      <CaseStack items={featured} />
    </div>
  </section>

  <!-- Process -->
  <section class="section" id="process" aria-labelledby="process-title">
    <div class="wrap">
      <SectionHead
        id="process-title"
        label="Process"
        aside="no surprises"
        title="Four steps, written down before any code"
        intro="The process is boring on purpose. You always know what is being built, why, and how we’ll measure whether it worked."
      />
      <ProcessSteps />
    </div>
  </section>

  <!-- Engineering standards -->
  <section class="section band" id="standards" aria-labelledby="standards-title">
    <div class="wrap">
      <SectionHead
        id="standards-title"
        label="Engineering standards"
        aside="the defaults"
        title="The parts clients don’t see, done anyway"
        intro="These aren’t add-ons I upsell. They are how I work on every project, and each comes with evidence from shipped code."
      />
      <ul class="std" role="list">
        {
          standards.map((s, i) => (
            <li class="std__item" data-reveal style={`--d:${i}`}>
              <span class="mono std__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h3">{s.title}</h3>
              <p class="std__body">{s.body}</p>
              <p class="std__proof">
                <Icon name="check" size={16} />
                <span>{s.proof}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Stack -->
  <section class="section stackband on-night" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="stackband__head" data-reveal>
        <Eyebrow label="Tech stack" aside="used in production" />
        <h2 id="stack-title" class="t-h2">Modern where it pays off. Boring where it should be.</h2>
      </div>
      <div class="stackband__groups">
        {
          stack.map((g, i) => (
            <div class="stackband__group" data-reveal style={`--d:${i}`}>
              <h3 class="mono">{g.group}</h3>
              <ul role="list">
                {g.items.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="faq-grid__head" data-reveal>
        <Eyebrow label="FAQ" aside="straight answers" />
        <h2 id="faq-title" class="t-h2">Questions people ask before a first call</h2>
        <p class="t-lead">Something not covered? <a class="link" href={href('contact')}>Ask me directly.</a></p>
      </div>
      <div data-reveal>
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <ContactSection source="home" />
</Base>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 88px) clamp(56px, 8vw, 112px);
  }
  .hero__grid {
    display: grid;
    gap: clamp(40px, 6vw, 64px);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
  .hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .hero__copy h1 {
    max-width: 17ch;
  }
  .hero__em {
    color: var(--color-muted);
  }
  .hero__lead {
    max-width: 54ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__proof {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    width: 100%;
    max-width: 520px;
  }
  .hero__proof :global(.hero__avatar) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    border: 2px solid var(--color-surface);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  .hero__proof p {
    display: grid;
    line-height: 1.4;
  }
  .hero__proof strong {
    font-weight: 560;
  }
  .hero__proof span {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .hero__visual {
    min-width: 0;
  }

  .clients {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .clients__inner {
    display: grid;
    gap: 1rem;
    padding-block: 1.75rem;
  }
  @media (min-width: 1024px) {
    .clients__inner {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 3rem;
    }
  }
  .clients__label {
    white-space: nowrap;
  }
  .clients__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 540;
    letter-spacing: -0.02em;
    color: var(--color-ink-soft);
  }
  .clients__list li:not(:last-child)::after {
    content: '/';
    margin-inline: 0.75rem;
    color: var(--color-line-strong);
    font-weight: 400;
  }

  .std {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .std {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .std__item {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-paper);
  }
  .std__num {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .std__body {
    color: var(--color-ink-soft);
  }
  .std__proof {
    display: flex;
    gap: 0.625rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .std__proof :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--color-accent);
  }

  .stackband {
    background: var(--color-night);
    color: var(--color-night-muted);
  }
  .stackband h2 {
    color: var(--color-on-night);
    max-width: 20ch;
    margin-top: 1.25rem;
  }
  .stackband__groups {
    display: grid;
    gap: 2rem;
    margin-top: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 640px) {
    .stackband__groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .stackband__groups {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stackband__group {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-night-line);
  }
  .stackband__group h3 {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3fd0a6;
    margin-bottom: 1rem;
  }
  .stackband__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stackband__group li {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-night-line);
    border-radius: 999px;
    color: var(--color-on-night);
    font-size: 0.9375rem;
  }

  .faq-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
    .faq-grid__head {
      position: sticky;
      top: 120px;
      align-self: start;
    }
  }
  .faq-grid__head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
</style>
